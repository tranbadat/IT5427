# Environment Configuration
ENV=development

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX_PREFIX=social_media

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=social_analytics

# PostgreSQL Configuration (for metadata)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_metadata

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=SocialMediaAnalytics
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050

# Data paths
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
OUTPUT_DATA_PATH=./data/output

# Processing Configuration
BATCH_SIZE=1000
MAX_WORKERS=4
DEDUP_THRESHOLD=0.85

# Sensitive words filter
SENSITIVE_WORDS_PATH=./configs/sensitive_words.txt

# Alert thresholds
SPIKE_DETECTION_THRESHOLD=2.5
VIRAL_THRESHOLD=10000
ANOMALY_ZSCORE=3.0

# Monitoring
PROMETHEUS_PORT=9090
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log
